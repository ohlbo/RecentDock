<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package source at the repository level.

  Needed because this machine's user-level NuGet.Config is an empty
  <configuration />, so `dotnet restore` finds zero sources and fails instantly
  with NU1100 ("unable to resolve ... for net8.0-windows") rather than
  attempting a download.

  Keeping it in the repository rather than in the user profile makes the build
  reproducible on any machine and avoids mutating global state.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
