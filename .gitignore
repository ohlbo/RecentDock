# repository.
.dotnet-home/
.nuget/
.tmp/
.cache/

# Generated by the test suite and the diagnostic switches
RecentDock-selftest.txt

# Visual Studio / Rider / VS Code user state
.vs/
.idea/
*.user
*.suo

# OS noise
Thumbs.db
desktop.ini
