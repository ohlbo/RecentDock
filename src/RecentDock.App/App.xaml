<Application x:Class="RecentDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    No StartupUri: the window is created in code so the single-instance check and
    the tray icon exist first. With StartupUri the window would be shown before
    either, flashing a panel in what turns out to be a duplicate process.
  -->
  <Application.Resources>
    <!--
      Translucent theme.

      Every surface here is deliberately semi-transparent: the window itself is
      transparent and the DWM paints its acrylic material behind it, so these
      alphas control how strongly the material reads through each region. They are
      also the entire appearance on Windows 10, where no system backdrop exists -
      which is why the alphas are high enough to keep text legible on their own
      rather than relying on the backdrop for contrast.

      Alpha budget, darkest to lightest:
        0xE6 (90%) outer tint   - sets the overall depth
        0xD9 (85%) header/footer - a touch heavier, reads as chrome
        0xCC (80%) list surface  - lightest, so the content area feels open
    -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#E61A1B1F" />
    <SolidColorBrush x:Key="GlassHeaderBrush" Color="#D924252B" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#CC16171A" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#4DFFFFFF" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFEDEEF1" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFA2A6AE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4C8DF6" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE8B25C" />

    <!-- Row states stay translucent too, so hovering does not punch an opaque hole
         in the glass. -->
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#334C8DF6" />

    <!-- Buttons: flat, translucent, with a visible hover rather than a border. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Context menu needs to be translucent as well: an opaque popup next to a glass
      panel looks like a rendering bug. The default WPF menu chrome is opaque, so it
      is replaced.
    -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#F21F2024" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="4">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#334C8DF6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="4,3" />
    </Style>

    <!-- CheckBox and its label follow the theme text colour. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
