<Application x:Class="RecentDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    No StartupUri: the window is created in code so the single-instance check and
    the tray icon exist first. With StartupUri the window would be shown before
    either, flashing a panel in what turns out to be a duplicate process.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          The palette and control templates live in their own dictionary so
          ThemeManager can rewrite individual entries at runtime: the opacity slider
          and the text-size option change the very keys defined there.
        -->
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
