<Application x:Class="RecentDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    No StartupUri: the window is created in code so the single-instance check and
    the tray icon exist first. With StartupUri the window would be shown before
    either, flashing a panel in what turns out to be a duplicate process.
  -->
  <Application.Resources>
    <!--
      LIGHT translucent theme - white glass.

      Important: the XAML palette is only half the appearance. The window itself is
      transparent and the DWM paints its acrylic material behind the client area, so
      the material's light/dark variant decides the base colour. That variant is
      selected by DWMWA_USE_IMMERSIVE_DARK_MODE in AcrylicBackdrop.Apply, and it is
      NOT taken from this file. A dark material under a light palette still renders
      as a black panel, which is exactly what happened before.

      Alpha budget. These surfaces sit ON TOP of the material, so:
        - too opaque  -> the glass is invisible and it looks like a flat panel
        - too clear   -> text loses contrast, especially on Windows 10 where there
                         is no acrylic behind it at all.

      White tint needs less opacity than a dark one for the same legibility, because
      dark text on light glass keeps its contrast further down. Measured by eye at
      the current values; 0xB3 is the sweet spot for the content area.

        0xB3 (70%) content area  - lightest, lets the desktop read through
        0xC0 (75%) header/footer  - a touch heavier, reads as window chrome
        0xCC (80%) outer tint     - sets the overall depth
    -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="GlassHeaderBrush" Color="#C0FFFFFF" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#59FFFFFF" />

    <!-- Text: near-black rather than pure black, which reads softer on glass. -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1C1C20" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5F6068" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6FD8" />

    <!-- Missing/failed markers need to stay legible on white: a mid amber works,
         a pale one disappears. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB4651A" />

    <!-- Row states darken instead of lighten, since the surface is light.
         Hovering must not turn a row into an opaque block. -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#332F6FD8" />

    <!-- Buttons: flat and translucent, distinguished by hover rather than a border. -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#14000000" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#22000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#38000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      The context menu is a separate popup with no acrylic behind it, so it needs a
      much more opaque fill than the panel: at panel alphas the desktop shows straight
      through and the text becomes unreadable. Near-opaque white with a hairline.
    -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#F7F7F8FA" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="#33000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="4">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#332F6FD8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Background" Value="#26000000" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="4,3" />
    </Style>

    <!-- CheckBox and its label follow the theme text colour. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
